# 6.7 Coffee — пример окружения.
#
# Скопируй в `.env` (не коммитится) и заполни значения.
# ВАЖНО: при NODE_ENV=production backend НЕ СТАРТУЕТ, если не задана хотя бы одна
# из переменных блока «критические» — см. backend/src/config.ts (productionConfigIssues).

# ── Критические (production падает на старте без них) ──────────────────────
NODE_ENV=production
PORT=3000

# Секрет подписи JWT гостя и админ-сессий. Не менее 32 случайных символов.
JWT_SECRET=
# Токен владельца (заголовок X-Admin-Token). Не «dev-admin».
ADMIN_TOKEN=
# Общий секрет облачного прокси Эвотора. Без него кассовые API закрыты (503).
EVOTOR_PROXY_TOKEN=
# Публичный адрес PWA — из него собираются QR и ссылки в письмах.
PUBLIC_BASE_URL=https://app.example.com
# 1 — доверять X-Forwarded-For / X-Real-IP (только если перед Node реально стоит прокси),
# 0 — не доверять (IP-лимиты по адресу тогда не применяются).
TRUST_PROXY_HEADERS=1

# ── Данные ────────────────────────────────────────────────────────────────
DB_PATH=./data/sixth-cup.db
UPLOADS_DIR=./data/uploads
KEYS_PATH=./data/keys.json

# ── Необязательные, но важные в проде ─────────────────────────────────────
# Отдельный секрет QR предзаказа. Пусто → используется JWT_SECRET.
ORDER_QR_SECRET=
# Второй и третий токены админки: только чтение / маркетинг без опасных операций.
ADMIN_VIEWER_TOKEN=
ADMIN_MARKETER_TOKEN=
# Точный host админки (иначе админка определяется по префиксу admin.).
ADMIN_HOST=admin.example.com
# Сброс данных из админки. В production по умолчанию выключен.
ADMIN_ALLOW_RESET=0
# Разрешённые CORS-origin через запятую (пусто = только dev-хосты).
CORS_ORIGINS=

# ── Интеграция Эвотор Cloud ───────────────────────────────────────────────
EVOTOR_API_TOKEN=
EVOTOR_API_BASE_URL=https://api.evotor.ru
EVOTOR_WEBHOOK_TOKEN=
# 1 — отклонять кассовые запросы без валидного прокси-токена даже на /ping.
EVOTOR_PROXY_ENFORCE=1

# ── Лояльность ────────────────────────────────────────────────────────────
# 1 — бонусный контур (проценты), 0 — старый подарочный (N чашек).
LOYALTY_BONUS_MODE=1

# ── Push (без ключей фича выключена, PWA отвечает 503 push_disabled) ───────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# ── AI-ассистент админки (без ключа честно 503) ───────────────────────────
AI_ASSISTANT=0
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
